# Berkas pengaturan tidak boleh dibuka lewat alamat web.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
Options -Indexes

# Header keamanan (aktif jika mod_headers tersedia).
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
    # Aktifkan baris berikut HANYA setelah HTTPS berjalan di subdomain lms.:
    # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
