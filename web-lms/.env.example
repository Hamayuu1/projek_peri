# Salin berkas ini menjadi .env, lalu isi. Jangan pernah upload .env ke GitHub.
# Server sebenarnya: buat pengguna MySQL khusus dengan database/buat_pengguna_db.sql (jangan pakai root).
# Laragon (pengembangan): pengguna root dengan kata sandi kosong masih bisa dipakai.
LMS_DB_HOST=127.0.0.1
LMS_DB_PORT=3306
LMS_DB_NAME=peri_lms
LMS_DB_USER=root
LMS_DB_PASS=

# Isi 1 jika LMS dilayani lewat HTTPS (wajib di server sebenarnya) agar cookie sesi hanya dikirim lewat HTTPS.
LMS_HTTPS=0

# Web lembaga: alamat server Flask. LMS mengambil pendaftaran lewat Flask, tidak lagi membaca database lembaga.
# LMS_KUNCI harus sama dengan PERI_LMS_KUNCI di peri-backend/.env. Buat dengan: python -c "import secrets;print(secrets.token_hex(32))"
LMS_FLASK_URL=http://127.0.0.1:5001
LMS_KUNCI=
