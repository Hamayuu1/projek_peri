# Salin berkas ini menjadi .env, lalu isi. Jangan pernah upload .env ke GitHub.
# Laragon (pengembangan): pengguna root dengan kata sandi kosong masih bisa dipakai.
# Server sebenarnya: buat pengguna MySQL khusus yang hanya punya hak atas database peri_lms.
LMS_DB_HOST=127.0.0.1
LMS_DB_PORT=3306
LMS_DB_NAME=peri_lms
LMS_DB_USER=root
LMS_DB_PASS=
