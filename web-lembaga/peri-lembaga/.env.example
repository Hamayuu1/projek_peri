# Salin menjadi ".env.local" lalu sesuaikan. Tidak wajib: tanpa berkas ini, login admin
# diarahkan ke /peri-admin/dashboard.html pada server Vite yang sama (npm run dev).
# Isi hanya jika panel admin dijalankan di alamat lain, lalu jalankan ulang "npm run dev".
# Gunakan host yang sama dengan situs ini (localhost ATAU 127.0.0.1, jangan dicampur),
# agar cookie login ikut terkirim.
# VITE_ADMIN_URL=http://localhost:5173/peri-admin/dashboard.html
